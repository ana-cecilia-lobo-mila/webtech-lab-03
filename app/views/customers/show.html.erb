<% content_for :title, @customer.name %>

<div class="container mt-5">
  <h1 class="mb-4 wheelhouse-title"><%= @customer.name %></h1>

  <div class="card mb-4">
    <div class="card-body">
      <p><strong>Phone:</strong> <%= @customer.phone.presence || "Not provided" %></p>
    </div>
  </div>

  <h2 class="mb-3">Bikes</h2>

  <% if policy(Bike).new? %>
    <%= link_to "Add Bike", new_bike_path(customer_id: @customer.id),
                class: "btn btn-primary wheelhouse-btn mb-3" %>
  <% end %>

  <% if @bikes.any? %>
    <div class="table-responsive">
      <table class="table table-striped table-hover wheelhouse-table">
        <thead>
          <tr>
            <th>Brand</th>
            <th>Model</th>
            <th>Color</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody>
          <% @bikes.each do |bike| %>
            <tr>
              <td><%= bike.brand %></td>
              <td><%= bike.model %></td>
              <td><%= bike.color.presence || "Not provided" %></td>
              <td>
                <% if policy(bike).show? %>
                  <%= link_to "View", bike_path(bike),
                              class: "btn btn-primary wheelhouse-btn btn-sm" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="alert alert-info wheelhouse-empty">
      This customer has no bikes.
    </div>
  <% end %>

  <% if policy(@customer).edit? %>
    <%= link_to "Edit Customer", edit_customer_path(@customer),
                class: "btn btn-primary wheelhouse-btn me-2" %>
  <% end %>

  <% if policy(@customer).destroy? %>
    <%= button_to "Delete Customer", @customer, method: :delete,
                  class: "btn btn-danger wheelhouse-btn",
                  data: { turbo_confirm: "Are you sure you want to delete #{@customer.name}?" } %>
  <% end %>

  <% if policy(Customer).index? %>
    <%= link_to "Back to customers", customers_path,
                class: "btn btn-secondary wheelhouse-btn" %>
  <% end %>
</div>