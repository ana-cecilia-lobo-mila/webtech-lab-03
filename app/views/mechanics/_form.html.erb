<%= form_with model: mechanic do |form| %>
  <% if mechanic.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% mechanic.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %> <%= form.text_field :name, class: "form-control #{'is-invalid' if mechanic.errors[:name].any?}" %>

    <% mechanic.errors.full_messages_for(:name).each do |message| %>
      <div class="invalid-feedback"><%= message %></div>
    <% end %>
  </div>

  <%= form.submit class: "btn btn-primary wheelhouse-btn" %>
<% end %>