<% content_for :title, @customer.name %>
<div class="container mt-5">
  <h1 class="mb-4 wheelhouse-title"><%= @customer.name %></h1>

  <div class="card mb-4">
    <div class="card-body">
      <p><strong>Phone:</strong><%= @customer.phone.presence || "Not provided" %></p>
    </div>
  </div>

  <h2 class="mb-3">Bikes</h2>

    <% if @customer.bikes.any? %> 
    <div class="table-responsive"> 
        <table class="table table-striped table-hover wheelhouse-table"> 
            <thead> 
                <tr> 
                    <th>Brand</th> 
                    <th>Model</th> 
                    <th>Color</th> 
                </tr> 
            </thead>


            <tbody>
                <% @customer.bikes.each do |bike| %>
                    <%= render "bikes/bike", bike: bike %>
                <% end %>
            </tbody>
        </table>
    </div>

    <% else %> 
    <div class="alert alert-info wheelhouse-empty">This customer has no bikes. </div>
    <% end %>

    <%= link_to "Back to customers", customers_path, class: "btn btn-secondary wheelhouse-btn" %>

</div>
