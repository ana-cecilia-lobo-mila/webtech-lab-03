<% content_for :title, @service.name %>
<div class="container mt-5">
  <h1 class="mb-4 wheelhouse-title"><%= @service.name %></h1>

  <div class="card mb-4">
    <div class="card-body">
      <p><strong>Service:</strong><%= @service.name %></p>

      <p><strong>Current price:</strong>$<%= number_with_delimiter(@service.price) %></p>
    </div>
  </div>

  <h2 class="mb-3">Repairs</h2>

    <% if @service.repair_services.any? %>
        <ul class="list-group mb-4">
        <% @service.repair_services.each do |repair_service| %>
            <li class="list-group-item">
            <%= link_to "Repair ##{repair_service.repair.id}",repair_path(repair_service.repair) %>
            </li>
        <% end %>
        </ul>
    <% else %>
        <div class="alert alert-info wheelhouse-empty">
        This service has not been used in any repairs.
        </div>
    <% end %>

    <%= link_to "Back to services", services_path, class: "btn btn-secondary wheelhouse-btn" %>
</div>