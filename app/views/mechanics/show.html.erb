<% content_for :title, @mechanic.name %>
<div class="container mt-5">
  <h1 class="mb-4 wheelhouse-title"><%= @mechanic.name %></h1>

  <div class="card mb-4">
    <div class="card-body">
        <p><strong>Name:</strong><%= @mechanic.name %></p>
    </div>
  </div>

  <h2 class="mb-3">Repairs</h2>

  <% if @mechanic.repair.any? %>
    <div class="table-responsive">
      <table class="table table-striped table-hover wheelhouse-table">
        <thead>
          <tr>
            <th>Bike</th>
            <th>Promised on</th>
            <th>State</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody>
          <% @mechanic.repair.each do |repair| %>
            <tr>
              <td>
                <%= link_to [repair.bike.brand, repair.bike.model].compact.join(" "),bike_path(repair.bike) %>
              </td>
              <td>
                <%= repair.promised_on.strftime("%d/%m/%Y") %>
              </td>
              <td>
                <%= repair.state.humanize %>
              </td>
              <td>
                <%= link_to "View", repair_path(repair), class: "btn btn-primary wheelhouse-btn btn-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% else %>
        <div class="alert alert-info wheelhouse-empty">This mechanic has no repairs.</div>
    <% end %>

    <%= link_to "Back to mechanics", mechanics_path,class: "btn btn-secondary wheelhouse-btn" %>
</div>