<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <h1 class="mb-4">Update your password</h1>

      <%= form_with url: password_path(params[:token]), method: :put do |form| %>
        <div class="mb-3">
          <%= form.label :password, "New password", class: "form-label" %>

          <%= form.password_field :password,
                required: true,
                autocomplete: "new-password",
                maxlength: 72,
                class: "form-control #{'is-invalid' if @user.errors[:password].any?}" %>

          <% @user.errors.full_messages_for(:password).each do |message| %>
            <div class="invalid-feedback">
              <%= message %>
            </div>
          <% end %>

          <div class="form-text">
            Password must be at least 10 characters.
          </div>
        </div>

        <div class="mb-3">
          <%= form.label :password_confirmation,
                "Password confirmation",
                class: "form-label" %>

          <%= form.password_field :password_confirmation,
                required: true,
                autocomplete: "new-password",
                maxlength: 72,
                class: "form-control #{'is-invalid' if @user.errors[:password_confirmation].any?}" %>

          <% @user.errors.full_messages_for(:password_confirmation).each do |message| %>
            <div class="invalid-feedback">
              <%= message %>
            </div>
          <% end %>
        </div>

        <%= form.submit "Save new password",
              class: "btn btn-primary w-100" %>
      <% end %>
    </div>
  </div>
</div>