<div class="container mt-5">
  <h1 class="mb-4 wheelhouse-title">Bikes</h1>

    <% if @bikes.any? %> <div class="table-responsive"> 
    <table class="table table-striped table-hover wheelhouse-table"> 
        <thead>
            <tr>
                <th>Brand</th>
                <th>Model</th>
                <th>Color</th>
                <th>Customer</th>
            </tr>
        </thead>

        <tbody>
            <% @bikes.each do |bike| %>
                <%= render "bike", bike: bike %>
            <% end %>
        </tbody>
    </table>
</div>


<% else %> <div class="alert alert-info wheelhouse-empty">
    No bikes found. </div>
<% end %>

</div>
