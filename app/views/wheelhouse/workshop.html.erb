  <div class="row mt-5">
    <div class="col-md-6 mb-4">
      <h2>Where are we</h2>
      <address class="mt-3 bg-light p-3 rounded">
        <strong>Wheelhouse Workshop</strong><br>
        47 W 13th St  4500<br>
        NY (Nueva York)<br>
      </address>
    </div>
    
    <div class="col-md-6 mb-4">
      <h2>Business Hours</h2>
      <ul class="list-group list-group-flush mt-3">
        <li class="list-group-item bg-transparent d-flex justify-content-between">
          <span>Monday to Friday</span> <strong>10:00 - 18:30</strong>
