<% content_for :title, [@bike.brand, @bike.model].compact.join(" ") %>

<div class="container mt-5">
  <h1 class="mb-4 wheelhouse-title">
    <%= [@bike.brand, @bike.model].compact.join(" ") %>
  </h1>

  <%= link_to "Add Repair",  new_repair_path(bike_id: @bike.id), class: "btn btn-primary wheelhouse-btn mb-3" %>
  <div class="card mb-4">
    <div class="card-body">
      <p><strong>Brand:</strong> <%= @bike.brand.presence || "Unknown" %></p>
      <p><strong>Model:</strong> <%= @bike.model.presence || "Unknown" %></p>
      <p><strong>Color:</strong> <%= @bike.color.presence || "Unknown" %></p>
      <p><strong>Serial number:</strong> <%= @bike.serial_number.presence || "Not provided" %></p>
      <p><strong>Customer:</strong> <%= link_to @bike.customer.name, customer_path(@bike.customer) %></p>
    </div>
  </div>

  <h2 class="mb-3">Repairs</h2>

  <% if @bike.repairs.any? %>
    <div class="table-responsive mb-4">
      <table class="table table-striped table-hover wheelhouse-table">
        <thead>
          <tr>
            <th>Photo</th>
            <th>Bike</th>
            <th>Mechanic</th>
            <th>Promised on</th>
            <th>State</th>
            <th>Diagnosis</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody>
          <%= render @bike.repairs %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="alert alert-info wheelhouse-empty">
      This bike has no repairs.
    </div>
  <% end %>

  <%= link_to "Edit Bike", edit_bike_path(@bike), class: "btn btn-primary wheelhouse-btn me-2" %>

  <%= button_to "Delete Bike", @bike, method: :delete, class: "btn btn-danger wheelhouse-btn", data: { turbo_confirm: "Are you sure you want to delete #{@bike.serial_number}?" } %>

  <%= link_to "Back to bikes", bikes_path, class: "btn btn-secondary wheelhouse-btn" %>
</div>
