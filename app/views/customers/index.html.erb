<div class="container mt-5">
  <h1 class="mb-4 wheelhouse-title">Customers</h1>

  <% if @customers.any? %> <div class="table-responsive"> 
    <table class="table table-striped table-hover wheelhouse-table"> 
      <tbody>
        <% @customers.each do |customer| %>
          <tr>
            <td>
              <%= link_to customer.name, customer_path(customer) %>
            </td>
            <td>
              <%= customer.phone.presence || "Not provided" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% else %> <div class="alert  wheelhouse-empty">
    No customers found. </div>
  <% end %>
</div>
