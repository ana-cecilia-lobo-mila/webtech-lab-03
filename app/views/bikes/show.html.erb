<% content_for :title, [@bike.brand, @bike.model].compact.join(" ") %>

<div class="container mt-5">
  <h1 class="mb-4 wheelhouse-title">
    <%= [@bike.brand, @bike.model].compact.join(" ") %>
  </h1>

  <div class="card mb-4">
    <div class="card-body">
      <p><strong>Brand:</strong> <%= @bike.brand.presence || "Unknown" %></p>
      <p><strong>Model:</strong> <%= @bike.model.presence || "Unknown" %></p>
      <p><strong>Color:</strong> <%= @bike.color.presence || "Unknown" %></p>
      <p><strong>Serial number:</strong> <%= @bike.serial_number.presence || "Not provided" %></p>
      <p><strong>Customer:</strong> <%= link_to @bike.customer.name, customer_path(@bike.customer) %></p>
    </div>
  </div>

  <h2 class="mb-3">Repairs</h2>

    <% if @bike.repairs.any? %> 
    <ul class="list-group mb-4">
        <% @bike.repairs.each do |repair| %> 
        <li class="list-group-item">
            <%= link_to "Repair ##{repair.id}", repair_path(repair) %> 
        </li>
        <% end %> 
    </ul>
    <% else %> 
    <div class="alert alert-info wheelhouse-empty"> This bike has no repairs. </div>
    <% end %>

    <%= link_to "Back to bikes", bikes_path, class: "btn btn-secondary wheelhouse-btn" %>
</div>
