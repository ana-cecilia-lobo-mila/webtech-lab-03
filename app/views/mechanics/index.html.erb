<div class="container mt-5">
  <h1 class="mb-4 wheelhouse-title">Mechanics</h1>

  <% if policy(Mechanic).new? %>
    <%= link_to "New Mechanic", new_mechanic_path,
                class: "btn btn-primary wheelhouse-btn mb-3" %>
  <% end %>

  <% if @mechanics.any? %>
    <div class="table-responsive">
      <table class="table table-striped table-hover wheelhouse-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody>
          <% @mechanics.each do |mechanic| %>
            <tr>
              <td>
                <%= mechanic.name %>
              </td>
              <td>
                <% if policy(mechanic).show? %>
                  <%= link_to "View", mechanic_path(mechanic),
                              class: "btn btn-primary wheelhouse-btn btn-sm" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% else %>
        <div class="alert  wheelhouse-empty"> No mechanics found.</div>
    <% end %>
</div>