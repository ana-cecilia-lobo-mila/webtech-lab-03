<div class="container mt-5">
  <h1 class="mb-4 wheelhouse-title">Services</h1>

  <% if @services.any? %>
    <div class="table-responsive">
      <table class="table table-striped table-hover wheelhouse-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Price</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody>
          <% @services.each do |service| %>
            <tr>
              <td>
                <%= service.name %>
              </td>
              <td>
                $<%= number_with_delimiter(service.price) %>
              </td>
              <td>
                <%= link_to "View", service_path(service),class: "btn btn-primary wheelhouse-btn btn-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% else %>
        <div class="alert  wheelhouse-empty">No services found.</div>
    <% end %>
</div>