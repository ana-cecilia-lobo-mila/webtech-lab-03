<div class="container mt-5">
  <h1 class="mb-4 wheelhouse-title">Repairs</h1>

  <%= link_to "New Repair", new_repair_path, class: "btn btn-primary wheelhouse-btn mb-3" %>

  <% if @repairs.any? %>
    <div class="table-responsive">
      <table class="table table-striped table-hover wheelhouse-table">
        <thead>
          <tr>
            <th>Photo</th>
            <th>Bike</th>
            <th>Mechanic</th>
            <th>Promised on</th>
            <th>State</th>
            <th>Diagnosis</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody>
          <%= render @repairs %>
        </tbody>
      </table>
    </div>
    <% else %>
        <div class="alert alert-info wheelhouse-empty">No repairs found.</div>
    <% end %>
</div>