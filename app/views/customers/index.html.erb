<% content_for :title, "Customers" %>

<div class="container mt-5">
  <h1 class="mb-4 wheelhouse-title">Customers</h1>

  <% if policy(Customer).new? %>
    <%= link_to "New Customer", new_customer_path,
                class: "btn btn-primary wheelhouse-btn mb-3" %>
  <% end %>

  <% if @customers.any? %>
    <div class="table-responsive">
      <table class="table table-striped table-hover wheelhouse-table">
        <tbody>
          <% @customers.each do |customer| %>
            <tr>
              <td>
                <% if policy(customer).show? %>
                  <%= link_to customer.name, customer_path(customer) %>
                <% else %>
                  <%= customer.name %>
                <% end %>
              </td>
              <td><%= customer.phone.presence || "Not provided" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="alert alert-info wheelhouse-empty">
      No customers found.
    </div>
  <% end %>
</div>